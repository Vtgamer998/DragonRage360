+        m=re.fullmatch(r'(?:\([^)]*\)\s*)?(-?(?:0x[0-9a-f]+|\d+))',s)
+        return int(m[1],0) if m else None
+    def name(s):
+        if '): ' in s:return s.rsplit('): ',1)[1]
+        return re.sub(r'^\([^)]*\)\s*','',s)
+    memo={}
+    def layout(off,extent=None,trail=()):
