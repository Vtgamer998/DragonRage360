+/* The player's frame loop: decodes and shows one picture per frame until the stream ends or START skips it. */
+void Movie_Run(void) {
+    Movie *m=gMovie;
+    XbMovieClock clock={0};u32 frame=0;int started=0,skip=0,wait=0;
+    if(!m || movie_error)return;
