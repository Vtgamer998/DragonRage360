+            current={'tag':m[3][7:],'attrs':{},'children':[]};dies[off]=current
+            if stack:dies[stack[-1]]['children'].append(off)
+            stack.append(off);continue
+        m=re.search(r'DW_AT_(\w+)\s*:\s*(.*)',line)
+        if m and current:current['attrs'][m[1]]=m[2]
+    def attrs(off):
