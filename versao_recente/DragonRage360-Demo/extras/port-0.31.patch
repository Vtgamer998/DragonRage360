+}
+NTSTATUS NtReadFile(HANDLE h,HANDLE event,void *apc,void *ctx,IO_STATUS_BLOCK *io,void *out,uint32_t n,const uint64_t *at) {
+    assert(h==1 && image && !event && !apc && !ctx && at);
