+static int path_of(const char *name,char path[256]) {
+    if(!name) return -1;
+    if(!strncasecmp(name,"cdrom0:",7))name+=7;
+    else if(!strncasecmp(name,"cdrom:",6))name+=6;
+    while(*name=='/' || *name=='\\')name++;
