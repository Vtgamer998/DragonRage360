+static int within_budget(Player *replace,size_t size) {
+    size_t used=size;
+    for(unsigned i=0;i<PLAYERS;i++)if(players+i!=replace && players[i].file){used+=players[i].size;if(used>MAX_TOTAL)return 0;}
+    return used<=MAX_TOTAL;
