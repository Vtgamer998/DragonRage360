+static int contains(uintptr_t lo,uintptr_t hi,uintptr_t at,size_t n)
+{return hi>=lo && at>=lo && at<=hi && n<=hi-at;}
+static int intersects(uintptr_t a,size_t an,uintptr_t b,size_t bn)
+{return a<=b?b-a<an:a-b<bn;}
