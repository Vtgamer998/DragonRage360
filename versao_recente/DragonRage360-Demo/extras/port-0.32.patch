+    if(!NT_SUCCESS(xsdk_audio_open(8))){reject(DEVICE);return;}
+    opened=1;
+}
+void *ADXT_Create(int channels,void *work,int worksize) {
+    if(!opened || device_dead || channels<1 || channels>2 || !work || worksize<128){reject(BAD);return NULL;}
