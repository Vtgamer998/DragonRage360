+    if(index!=0)return XBOV_CATALOG;
+    ov.busy=1;size_t at=0;
+    for(size_t i=0;i<ov.count;i++){if(ov.regions[i].policy==XBOV_RESET)memcpy(ov.regions[i].begin,ov.initial+at,ov.regions[i].expected);at+=ov.regions[i].expected;}
+    ov.busy=0;return 0;
+}
