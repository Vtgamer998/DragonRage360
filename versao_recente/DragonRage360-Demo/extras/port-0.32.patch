+int func_00277A70(void *h){Player *p=player(h);return p?p->reading:0;}
+static int adopt(Player *p,uint8_t *file,size_t size) {
+    stop(p);error=0;
+    if(size<0x40 || size>MAX_FILE || be16(file)!=0x8000 || file[4]!=3 || file[5]!=18 || file[6]!=4 ||
