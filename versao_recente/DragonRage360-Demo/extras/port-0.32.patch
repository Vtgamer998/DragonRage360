+s32 Overlay_Load(s32 idx) {
+    s32 fd;
+    s32 size;
+
+    do {
+        fd = sceOpen(gOverlayTbl[idx].path, SCE_RDONLY);
+    } while (fd < 0);
+    size = sceLseek(fd, 0, SCE_SEEK_END);
+    sceLseek(fd, 0, SCE_SEEK_SET);
+    FlushCache(0);
+    while (sceRead(fd, MainMenu_StartBallLoops, size) != size) {
+    }
+    FlushCache(2);
+    sceClose(fd);
+    return 0;
