+def function(name):
+ start=text.index(name);start=text.rfind('\n',0,start)+1;br=text.index('{',start);depth=1;at=br+1
+ while depth:
+  if text[at]=='{':depth+=1
+  if text[at]=='}':depth-=1
+  at+=1
+ return text[start:at]
