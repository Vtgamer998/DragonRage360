+    Gfx_Init();
+    Snd_Init();
+    File_Init();
+    Movie_Init();
+    Common_Init();
+    Common_LoadBoot();
+    Common_Reload();
+    Progress_Init();
+    Save_Init();
+    Job_Init();
+    Vu0_Init();
+    Dma_InitBuffers();
+    Dbg_Init();
+    Pad_Init();
+    McCard_Init();
+    Font_Init(1);
+    FontIcon_Init();
+    Fade_Init();
+    PadWatch_Init();
+    for (;;) {
+#ifdef PORT_BIGENDIAN
+        if(Overlay_Load(0)!=0)return;
+#else
