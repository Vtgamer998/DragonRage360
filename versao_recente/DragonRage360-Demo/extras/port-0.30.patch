+static int valid_store(const NativeStore *s) {
+    return s->magic==0x58534753 && s->version==1 && s->bp>=0 && s->bp<0x1c00 &&
+        !(s->bp&7) && s->bw==8 && s->psm==1 && s->x>=0 && s->y>=0 &&
+        s->w>0 && s->h>0 && s->w<=512 && s->h<=448 &&
+        s->x<=512-s->w && (s->bp%0xe00)/8+s->y<=448-s->h;
