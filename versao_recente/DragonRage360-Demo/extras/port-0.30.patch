+int32_t sceGsSyncPath(int32_t mode,uint16_t timeout) {
+    if(mode || timeout) return DR_GS_SDK_ARGUMENT;
+    int e=GsDraw_XenosSubmit();return e?e:dr_gs_backend_sync();
