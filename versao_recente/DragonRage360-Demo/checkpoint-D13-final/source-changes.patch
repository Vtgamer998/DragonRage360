+#define C3F(a,b) do{int error=c3fields(d,s,n,(a),(b),4,1);if(error)return error;}while(0)
+#define C3H(a,b) do{int error=c3fields(d,s,n,(a),(b),2,0);if(error)return error;}while(0)
