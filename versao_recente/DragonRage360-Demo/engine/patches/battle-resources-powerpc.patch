 /* Loads a 32-bit word. */
 s32 Mem_LoadWord(const void *p) {
+#ifdef DR_XBOX360
+    u32 bits = dr_resource_le32(p);
+    s32 value;
+    __builtin_memcpy(&value, &bits, sizeof(value));
+    return value;
+#else
     return *(const s32 *)p;
+#endif
 }
 
 /* Loads a float. */
 f32 Mem_LoadFloat(const void *p) {
+#ifdef DR_XBOX360
+    u32 bits = dr_resource_le32(p);
+    f32 value;
+    __builtin_memcpy(&value, &bits, sizeof(value));
+    return value;
+#else
     return *(const f32 *)p;
+#endif
 }
 
 /* Loads an unsigned 16-bit value. */
 u16 Mem_LoadHalf(const void *p) {
+#ifdef DR_XBOX360
+    const u8 *b = p;
+    return (u16)((u16)b[0] | (u16)b[1] << 8);
+#else
     return *(const u16 *)p;
+#endif
 }
 
