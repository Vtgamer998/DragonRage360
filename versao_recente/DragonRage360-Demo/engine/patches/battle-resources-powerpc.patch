 /* Returns entry n of a file's offset table, NULL when the entry is empty. */
+#ifdef DR_XBOX360
+/* The original object table has 12 stable IDs (btl_obj.h / BtlObj_InitTable).
+   Non-fighter objects have no BobjWork. A fixed, ID-indexed arena gives those
+   motions the same lifetime as the object, without changing file bytes or
+   leaking a new allocation on every animation switch. Reused IDs are copied
+   afresh. The old rollback snapshot does NOT capture this arena; online
+   integration must capture it or reconstruct immutable motion buffers. */
+extern void *Dr360_ObjGet(s32 id) __asm__("BtlObj_Get");
+static u8 sDr360ModelMotion[12][BOBJ_WORK_LAYER_SIZE] __attribute__((aligned(16)));
+static void *Dr360_ModelBuffer(void *object) {
+    BobjObj *obj = object;
+    s32 i;
+    if (obj == NULL) return NULL;
+    if (obj->work != NULL) return obj->work->layer[0];
+    for (i = 0; i < 12; i++) {
+        if (Dr360_ObjGet(i) == object) return sDr360ModelMotion[i];
+    }
+    return NULL;
+}
+static size_t Dr360_MotionSpan(void *object, const void *entry) {
+    BObj *obj = object;
+    s32 i;
+    size_t length;
+    if (obj == NULL || obj->slot == NULL || entry == NULL) return 0;
+    for (i = 0; i < 3; i++) {
+        BObjFile *file = &obj->slot->file[i];
+        if (file->buf != NULL && file->size > 0 &&
+            dr_pack_memory_span(file->buf, (size_t)file->size, entry, &length) == DR_OK) return length;
+    }
+    return 0;
+}
+#endif
 void *BObjFile_GetEntry(BObjFile *file, s32 n) {
+#ifdef DR_XBOX360
+    size_t offset, length;
+    if (file == NULL || file->buf == NULL || file->size <= 0 || n < 1) return NULL;
+    if (dr_pack_memory_entry(file->buf, (size_t)file->size, (u32)(n - 1),
+                             &offset, &length, NULL) != DR_OK) return NULL;
+    return (u8 *)file->buf + offset;
+#else
     u32 *buf = file->buf;
-
     if (buf[n + 1] != buf[n]) {
         return (u8 *)buf + (buf[n] >> 2 << 2);
     }
     return NULL;
+#endif
 }
 
