+/* IPv4 resolution through getaddrinfo, provided by xsdk (no legacy hostent). */
+static int resolve_ipv4(const char *name, struct in_addr *address) {
+    struct addrinfo hints, *result = NULL;
+    int ok;
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_DGRAM;
+    if (getaddrinfo(name, NULL, &hints, &result) != 0) return 0;
+    ok = result != NULL && result->ai_family == AF_INET && result->ai_addrlen >= sizeof(struct sockaddr_in);
+    if (ok) *address = ((const struct sockaddr_in *)result->ai_addr)->sin_addr;
+    if (result != NULL) freeaddrinfo(result);
+    return ok;
+}
 
